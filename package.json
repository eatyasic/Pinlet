{
  "name": "pinlet",
  "productName": "Pinlet",
  "version": "0.2.0",
  "description": "화면 위 어디에나 마커를 띄워 두는 데스크톱 앱",
  "author": "eatyasic",
  "license": "MIT",
  "homepage": "https://github.com/eatyasic/Pinlet",
  "repository": {
    "type": "git",
    "url": "https://github.com/eatyasic/Pinlet.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "snapshot": "node scripts/snapshot.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "app.pinlet.desktop",
    "productName": "Pinlet",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/{src,doc,vendor,lib}/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/build/koffi/win32_x64/koffi.{exp,lib}"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "files": [
        "src/**/*",
        "assets/**/*",
        "package.json",
        "!node_modules/koffi/**"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/win",
          "to": "vendor",
          "filter": [
            "VirtualDesktopAccessor.dll",
            "LICENSE.txt"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eatyasic",
        "repo": "Pinlet"
      }
    ],
    "dmg": {
      "title": "${productName}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pinlet"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "koffi": "2.16.3"
  }
}
